# --- API keys (server-side only; never expose to the client) ---

# Primary model chain. Free key, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Second tier (Groq, gpt-oss-120b). Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=

# Primary chain (paid): gemini-3.1-flash-lite → deepseek-v4-flash, with :free models
# as overflow. Funded key recommended — paid usage is pennies per answer. An unfunded
# key still serves :free models (50 req/day; 1,000/day after a one-time $10 top-up).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Server ---

PORT=8787

# Bind address. Defaults to 0.0.0.0 (all interfaces) for direct hosting.
# Set to 127.0.0.1 when behind a same-host reverse proxy (Caddy/nginx) so the
# port is only reachable through the proxy's TLS, not from the public internet.
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the API.
# Dev default below; set to your production origin when deploying.
ALLOWED_ORIGIN=http://localhost:5173

# Set to 1 when running behind a trusted reverse proxy (Railway, Render, nginx…)
# so the per-IP burst limit sees the real client address. On Vercel this is automatic.
TRUST_PROXY=0

# Per-IP burst limit on /api/chat — an anti-abuse ceiling for the paid key, not a
# quota guard. Default 60 req/min; set to 0 to disable entirely.
# RATE_LIMIT_PER_MIN=60

# Optional: persistent path for the MCP knowledge index (SQLite). On a long-running
# host (VPS) point this at a durable location so the index survives reboots instead
# of rebuilding in the per-boot tmpdir. Example: /var/lib/ask-satoshi/knowledge.sqlite
# BSV_AIO_DB_PATH=
